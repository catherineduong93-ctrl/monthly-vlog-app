# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# From the Dropbox App Console (https://www.dropbox.com/developers/apps)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Must exactly match a "Redirect URI" registered on the Dropbox app.
DROPBOX_REDIRECT_URI=http://localhost:3000/api/auth/dropbox/callback

# Path to the Dropbox folder your Insta360 exports + photos land in.
# Use "" (or "/") for the root of your Dropbox. Otherwise start with a
# single leading slash and no trailing slash, e.g. /Camera Uploads/Vlog.
DROPBOX_FOLDER_PATH=

# Optional: a Dropbox folder of mp3/m4a/aac/wav/flac/ogg tracks to pick as
# background music when generating a video. Leave blank to hide the music
# picker entirely.
DROPBOX_MUSIC_FOLDER_PATH=

# Local SQLite database file (created automatically).
DATABASE_PATH=./data/app.db
